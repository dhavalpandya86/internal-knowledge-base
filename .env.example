# ─────────────────────────────────────────────────────────────
# Internal Knowledge Base — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# --- Database (Postgres) ---
# Matches docker-compose.yml defaults. Change for your own server.
DATABASE_URL="postgresql://ikb:ikb_password@localhost:5432/internal_kb?schema=public"

# --- Local file storage ---
# All uploaded/processed files stay on your own disk for privacy.
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=25

# --- AI providers ---
# Default provider used when the UI doesn't specify one: claude | openai | gemini
AI_DEFAULT_PROVIDER="claude"

# Anthropic (Claude)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# --- HubSpot CRM ---
# Private App token (Settings → Integrations → Private Apps).
# Needs the `tickets` read scope.
HUBSPOT_ACCESS_TOKEN=""
# When true (or when no token is set), the app serves realistic mock tickets
# so you can run the whole flow without a live HubSpot connection.
HUBSPOT_USE_MOCK="true"
